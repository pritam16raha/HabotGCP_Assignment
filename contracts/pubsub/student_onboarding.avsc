{
  "type": "record",
  "name": "StudentOnboardingCanonicalEvent",
  "namespace": "io.habot.onboarding.v1",
  "doc": "Author: Pritam Raha <rahapritam32@gmail.com>. Canonical validated event for BigQuery delivery.",
  "fields": [
    {"name": "schema_version", "type": "string"},
    {"name": "submission_id", "type": "string"},
    {"name": "submitted_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "organisation_id", "type": "string"},
    {"name": "student_external_id", "type": "string"},
    {"name": "student_first_name", "type": "string"},
    {"name": "student_last_name", "type": "string"},
    {"name": "student_date_of_birth", "type": {"type": "int", "logicalType": "date"}},
    {"name": "emirate", "type": "string"},
    {"name": "school_name", "type": "string"},
    {"name": "learning_support_required", "type": "boolean"},
    {"name": "has_formal_diagnosis", "type": "boolean"},
    {"name": "diagnosis_codes", "type": {"type": "array", "items": "string"}},
    {"name": "guardian_full_name", "type": "string"},
    {"name": "guardian_email", "type": "string"},
    {"name": "guardian_phone_e164", "type": "string"},
    {"name": "guardian_relationship", "type": "string"},
    {"name": "consent_to_process", "type": "boolean"},
    {"name": "consent_timestamp", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "support_areas", "type": {"type": "array", "items": "string"}},
    {"name": "requested_hours_per_week", "type": "long"},
    {"name": "preferred_language", "type": "string"},
    {"name": "wheelchair_access_required", "type": "boolean"},
    {"name": "dcyn_all_rules_passed", "type": "boolean"},
    {"name": "dcyn_failed_rule_ids", "type": {"type": "array", "items": "string"}},
    {"name": "ingested_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "source_object_uri", "type": "string"}
  ]
}
